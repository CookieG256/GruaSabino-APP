{
  "name": "gruas-sabino-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo mobile da Grúas Sabino com Capacitor",
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build:web": "npm run build:css && node scripts/copy-web.mjs",
    "sync": "npm run build:web && cap sync",
    "release:android": "sh scripts/build-android-release.sh",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@fortawesome/fontawesome-free": "^6.4.0",
    "tailwindcss": "^3.4.19"
  }
}
